# hub-server environment (copy to .env for local development).
# Command-line flags override these values; see `hub-server --help`.
# Wrap any value containing `$` in single quotes, e.g. KEY='pa$word', or it
# is treated as a variable reference.

# Ports. --rest-port and --grpc-port override these.
REST_PORT=8443
GRPC_PORT=50053

# PostgreSQL. The server connects as two roles:
#   DATABASE_URL           hubappusr       runtime role, Row-Level Security enforced (NOSUPERUSER, NOBYPASSRLS)
#   DATABASE_PLATFORM_URL  hubplatformusr  platform admin and background jobs (BYPASSRLS)
# hubownerusr owns the database and runs migrations; the server never connects as it.
DATABASE_URL=postgres://hubappusr:change-me@localhost:5432/hub
DATABASE_PLATFORM_URL=postgres://hubplatformusr:change-me@localhost:5432/hub

# Migrations only (make migrate / make migrate-revert). The server never reads it.
DATABASE_OWNER_URL=postgres://hubownerusr:change-me@localhost:5432/hub

# Redis (transient state only)
REDIS_URL=redis://127.0.0.1:6379

# Logging (loxide): trace | debug | info | warn | error | fatal
LOG_LEVEL=info
